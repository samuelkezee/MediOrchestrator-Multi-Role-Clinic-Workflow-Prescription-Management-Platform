bin/
obj/
[Bb]in/
[Oo]bj/
out/
publish/
[Pp]ublish/
Generated_Code/

## Visual Studio temporary and cache files
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.dbmdl
*.jfm
*.pidb
*.booproj
*.svclog

## Rider & JetBrains IDEs
.idea/
*.sln.iml

## Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

## Test Results and Coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.visualstudio.diagnostics
*.coverage
*.coveragexml

## Entity Framework / Migrations bundles
*.idb
*.pdb

## Secrets and Local Configs
appsettings.*.local.json
appsettings.Local.json
secrets.json

# ------------------------------------------
# Node / Angular Frontend
# ------------------------------------------
## Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

## Angular build outputs and cache
dist/
tmp/
out-tsc/
bazel-out/
.angular/cache/
.sass-cache/

## Testing & Coverage
coverage/
__screenshots__/
testem.log
/typings

## Environment files
.env
.env.*
*.env
!.env.example

# Preserve Angular environment configurations
!**/src/environments/environment.ts
!**/src/environments/environment.development.ts
!**/src/environments/environment.*.ts

